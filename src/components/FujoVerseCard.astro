---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";

type ContactData = CollectionEntry<"contacts">["data"];

interface Props {
  link: ContactData;
  tilt?: string;
}

const { link, tilt = "0deg" } = Astro.props;
---

<div class="@container/fujoverse-card h-full min-w-0" style={`--tilt: ${tilt}`}>
  <div
    class="relative flex h-full min-h-28 rotate-[var(--tilt,0deg)] flex-col rounded-2xl border-2 border-transparent p-4 text-inherit shadow-[0_5px_14px_rgba(77,46,145,0.12)] transition-[transform,box-shadow] duration-[180ms] ease-[ease] hover:-translate-y-[3px] hover:rotate-0 hover:shadow-[0_8px_20px_rgba(77,46,145,0.2)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:rotate-[var(--tilt,0deg)]"
  >
    <a
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
      class="focus-visible:outline-3 @min-[16rem]/fujoverse-card:grid-cols-[auto_minmax(0,1fr)_auto] group grid min-w-0 flex-1 grid-cols-[minmax(0,1fr)_auto] items-center gap-3 text-inherit !no-underline focus-visible:rounded-xl focus-visible:outline-offset-[3px] focus-visible:outline-[rgba(67,96,247,0.6)]"
    >
      <span
        class="@min-[20rem]/fujoverse-card:size-16 @min-[28rem]/fujoverse-card:size-[4.5rem] flex size-14 max-w-full items-center justify-center overflow-hidden rounded-xl bg-[linear-gradient(135deg,#fff1a8,#f7c8ff)] shadow-[inset_0_0_0_1px_rgba(77,46,145,0.12)]"
      >
        <Image
          src={link.image}
          alt={link.imageAlt}
          width="72"
          height="72"
          loading="lazy"
          decoding="async"
          class="size-full object-cover"
        />
      </span>
      <span
        class="@min-[16rem]/fujoverse-card:col-[2] @min-[16rem]/fujoverse-card:row-[1] col-span-full row-start-2 flex min-w-0 flex-1 flex-col gap-[0.35rem] [overflow-wrap:anywhere]"
      >
        <strong
          class="@min-[20rem]/fujoverse-card:text-[1.0625rem] @min-[28rem]/fujoverse-card:text-lg text-balance font-zeitung text-base leading-[1.2] text-[#A700CF] underline-offset-[0.18em] group-hover:underline group-focus-visible:underline"
        >
          {link.title}
        </strong>
        <span
          class="@min-[28rem]/fujoverse-card:text-base text-pretty text-[0.95rem] leading-[1.35] text-[rgba(77,46,145,0.72)]"
        >
          {link.description}
        </span>
      </span>
      <Icon
        name="lucide:arrow-up-right"
        size={22}
        aria-hidden="true"
        class="@min-[16rem]/fujoverse-card:col-start-3 col-start-2 row-start-1 flex-none text-[#4360F7] opacity-[0.55] transition-[opacity,transform] duration-[180ms] ease-[ease] group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:opacity-100 group-focus-visible:-translate-y-0.5 group-focus-visible:translate-x-0.5 group-focus-visible:opacity-100 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0 motion-reduce:group-hover:translate-y-0 motion-reduce:group-focus-visible:translate-x-0 motion-reduce:group-focus-visible:translate-y-0"
      />
    </a>
    <ul
      class="m-0 mt-3 flex list-none flex-wrap justify-end gap-1.5 border-t border-t-[rgba(77,46,145,0.1)] p-0 pt-3"
      aria-label={`${link.title} links`}
    >
      <li class="m-0 min-w-0 max-w-full first:me-auto">
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${link.title} home page`}
          class="flex min-h-8 w-auto min-w-8 items-center justify-center gap-1.5 rounded-xl bg-gradient-to-b from-[#CE00FF] to-[#A700CF] px-2.5 py-1.5 font-hatch text-sm font-medium leading-[1.2] text-white !no-underline transition-[color] duration-[150ms] ease-[ease] [overflow-wrap:anywhere] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(67,96,247,0.65)] motion-reduce:transition-none"
        >
          <Icon
            name="lucide:house"
            size={16}
            aria-hidden="true"
            class="shrink-0"
          />
          <span>
            {new URL(link.href).hostname.replace(/^www\./, "")}
          </span>
        </a>
      </li>
      {
        link.socials.map((social) => (
          <li class="m-0 min-w-0 max-w-full">
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${link.title} on ${social.label}`}
              class="flex min-h-8 w-8 items-center justify-center !no-underline transition-[color] duration-[150ms] ease-[ease] hover:text-fujo-pink hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(67,96,247,0.65)] motion-reduce:transition-none"
            >
              <Icon name={social.icon} size={18} aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
