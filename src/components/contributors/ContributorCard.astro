---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type ContributorData = CollectionEntry<"contributors">["data"];
type ContributorRoles = CollectionEntry<"contributors">["data"]["roles"];

interface Props {
  slug: string;
  name: ContributorData["name"];
  contacts: ContributorData["contacts"];
  avatar: ContributorData["avatar"];
  roles?: ContributorRoles;
  chips: ContributorData["chips"];
  mode?: "link" | "display";
}

const {
  name,
  contacts,
  avatar,
  slug,
  roles,
  chips,
  mode = "display",
} = Astro.props;
const isLinkMode = mode === "link";
const hasContacts = contacts.length > 0;

const allRoles = Object.values(roles ?? {}).flat();

const characterDesignTags = allRoles
  .filter((r) => r.chips.includes("Character Design") && r.details)
  .map((r) => `Character Design: ${r.details}`);

const roleTags = [
  ...new Set<string>([
    ...chips.filter((chip) => chip !== "Character Design"),
    ...characterDesignTags,
  ]),
].slice(0, 4);

const getContactLabel = (
  contact: ContributorData["contacts"][number],
  url: URL,
) => {
  if (contact.username) return `@${contact.username}`;
  return `${url.hostname}${url.pathname === "/" ? "" : url.pathname}`;
};
---

<div
  class:list={[
    "outer-box group relative z-10 flex w-80 min-w-72 max-w-full flex-col rounded-2xl",
    isLinkMode ? "link-mode" : "display-mode",
    !hasContacts && "compact-card",
  ]}
>
  <h3
    class="header-row m-0 flex items-center gap-3 self-center text-balance text-xl not-italic"
    id={`${slug}`}
  >
    {
      isLinkMode ? (
        <a
          href={`/contributors/${slug}`}
          class="card-link flex items-center justify-center gap-3 !no-underline"
        >
          <Image
            class="rounded-xl object-cover"
            width={40}
            height={40}
            src={avatar}
            alt=""
          />
          <span class="card-name -mt-1 text-balance text-center font-zeitung text-fujo-pink">
            {name}
          </span>
          <Icon
            name="lucide:arrow-right"
            size={20}
            class="arrow-icon -ml-1 text-fujo-pink opacity-40 transition-all"
          />
        </a>
      ) : (
        <div class="flex items-center justify-center gap-3">
          <Image
            class="rounded-xl object-cover"
            width={40}
            height={40}
            src={avatar}
            alt="Avatar of the contributor"
          />
          <span class="-mt-1 text-balance text-center font-zeitung text-fujo-pink">
            {name}
          </span>
        </div>
      )
    }
  </h3>
  {
    !isLinkMode && (
      <button
        class="copy-button absolute right-2 top-2 inline-flex size-10 items-center justify-center rounded-lg text-fujo-pink opacity-40 transition-all hover:opacity-100"
        data-url={`/contributors/${slug}`}
        aria-label="Copy link to this profile"
      >
        <Icon name="lucide:copy" size={18} class="copy-icon" />
        <Icon name="lucide:check" size={18} class="check-icon hidden" />
      </button>
    )
  }
  {
    roleTags.length > 0 && (
      <ul class="role-list flex flex-wrap justify-center gap-1.5 text-balance">
        {roleTags.map((tag) => (
          <li class="role-chip mt-0 text-balance">{tag}</li>
        ))}
      </ul>
    )
  }
  {
    hasContacts && (
      <ul class="contacts-list flex flex-col">
        {contacts.map((contact) => {
          const url = new URL(contact.url);
          return (
            <li class="contact-row mt-0">
              <a
                href={contact.url}
                class="group/contact flex items-center gap-3 !no-underline"
              >
                <div class="flex rounded-lg bg-fujo-purple/10 p-2 group-hover/contact:bg-fujo-purple/20">
                  <Icon
                    size={24}
                    aria-label={
                      contact.platform === "web" ? "website" : contact.platform
                    }
                    name={contact.icon ?? "world-www"}
                    class="flex-shrink-0"
                  />
                </div>
                <span class="-mt-1 truncate">
                  {getContactLabel(contact, url)}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    )
  }
</div>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        entry.target.classList.toggle("is-visible", entry.isIntersecting);
      }
    },
    { rootMargin: "50px" },
  );
  document
    .querySelectorAll(".outer-box")
    .forEach((card) => observer.observe(card));
</script>

<script>
  document.querySelectorAll(".copy-button").forEach((button) => {
    button.addEventListener("click", async () => {
      const url = new URL(
        button.getAttribute("data-url") || "",
        window.location.origin,
      );
      const copyIcon = button.querySelector(".copy-icon");
      const checkIcon = button.querySelector(".check-icon");

      try {
        await navigator.clipboard.writeText(url.toString());
        copyIcon?.classList.add("hidden");
        checkIcon?.classList.remove("hidden");
        setTimeout(() => {
          copyIcon?.classList.remove("hidden");
          checkIcon?.classList.add("hidden");
        }, 2000);
      } catch (err) {
        console.error("Failed to copy:", err);
      }
    });
  });
</script>

<style>
  @property --gradient-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  .outer-box {
    --gradient-pink-rgb: 255, 33, 233;
    --gradient-blue-rgb: 67, 96, 247;
    border: 2px solid transparent;
    padding: 0.625rem 0.625rem 0.75rem;
    gap: 0.5rem;
    background:
      linear-gradient(white, white) padding-box,
      conic-gradient(
          from var(--gradient-angle),
          rgba(var(--gradient-pink-rgb), 0.8),
          rgba(var(--gradient-blue-rgb), 0.8),
          rgba(var(--gradient-pink-rgb), 0.8),
          rgba(var(--gradient-blue-rgb), 0.8),
          rgba(var(--gradient-pink-rgb), 0.8)
        )
        border-box;
    transition: box-shadow 0.2s ease;
  }

  @media (min-width: 768px) {
    .outer-box {
      padding: 0.75rem 0.75rem 0.875rem;
    }
  }

  .link-mode {
    cursor: pointer;
  }

  .link-mode .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 0.75rem;
  }

  .link-mode:hover:not(:has(.contact-row a:hover)) .header-row {
    background: linear-gradient(
      to right,
      rgba(var(--gradient-pink-rgb), 0.15),
      rgba(var(--gradient-blue-rgb), 0.1)
    );
  }

  .link-mode:hover:not(:has(.contact-row a:hover)) .arrow-icon {
    opacity: 1;
    transform: translateX(0.25rem);
  }

  .link-mode:hover:not(:has(.contact-row a:hover)) .card-name {
    text-decoration: underline;
  }

  .link-mode:hover {
    box-shadow: 0 0 15px rgba(var(--gradient-pink-rgb), 0.15);
  }

  .display-mode {
    cursor: default;
  }

  .compact-card .card-link {
    flex-wrap: wrap;
    row-gap: 0.375rem;
  }

  .role-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contacts-list {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .role-chip {
    border: 1px solid rgba(var(--gradient-pink-rgb), 0.2);
    border-radius: 999px;
    background: rgba(var(--gradient-blue-rgb), 0.06);
    padding: 0.1875rem 0.5rem;
    color: rgb(var(--gradient-blue-rgb));
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.15;
    text-align: center;
    text-wrap: balance;
  }

  .copy-button:hover {
    background: linear-gradient(
      to right,
      rgba(var(--gradient-pink-rgb), 0.15),
      rgba(var(--gradient-blue-rgb), 0.1)
    );
  }

  /* Shared styles */
  .header-row {
    border-radius: 0.875rem;
    padding: 0.375rem 0.75rem 0.5rem;
    transition: background 0.15s ease;
  }

  .contact-row {
    border-radius: 0.625rem;
    padding: 0.25rem 0.375rem;
    transition: background 0.15s ease;
  }

  .contact-row a {
    position: relative;
    z-index: 1;
  }

  .contact-row:has(a:hover) {
    background: linear-gradient(
      to right,
      rgba(var(--gradient-pink-rgb), 0.2),
      rgba(var(--gradient-blue-rgb), 0.15)
    );
  }

  .outer-box:global(:has(*:target)) h3 {
    font-weight: bold;
  }

  .outer-box:global(:has(*:target)) {
    background:
      linear-gradient(#ffd8fb, #ffd8fb) padding-box,
      conic-gradient(
          from var(--gradient-angle),
          rgba(var(--gradient-pink-rgb), 0.8),
          rgba(var(--gradient-blue-rgb), 0.8),
          rgba(var(--gradient-pink-rgb), 0.8),
          rgba(var(--gradient-blue-rgb), 0.8),
          rgba(var(--gradient-pink-rgb), 0.8)
        )
        border-box;
  }

  @media (prefers-reduced-motion: no-preference) {
    .outer-box.is-visible {
      animation: rotate-gradient 6s linear infinite;
    }

    /* Stagger animation start for each card */
    .outer-box:nth-child(6n + 1) {
      animation-delay: 0s;
    }
    .outer-box:nth-child(6n + 2) {
      animation-delay: -1s;
    }
    .outer-box:nth-child(6n + 3) {
      animation-delay: -2s;
    }
    .outer-box:nth-child(6n + 4) {
      animation-delay: -3s;
    }
    .outer-box:nth-child(6n + 5) {
      animation-delay: -4s;
    }
    .outer-box:nth-child(6n + 6) {
      animation-delay: -5s;
    }

    @keyframes rotate-gradient {
      to {
        --gradient-angle: 360deg;
      }
    }
  }
</style>
