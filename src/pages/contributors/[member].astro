---
import type { GetStaticPaths } from "astro";
import { type CollectionEntry, getCollection, getEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ContributorCard from "../../components/contributors/ContributorCard.astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const contributorsCollection = await getCollection("contributors");
  return contributorsCollection.flatMap((member, index) => {
    const contributorAliases = [
      ...new Set([member.id, ...member.data.aliases]),
    ];

    return contributorAliases.map((alias) => ({
      params: {
        member: alias,
      },
      props: {
        contributorId: member.id,
        next:
          index < contributorsCollection.length - 1
            ? contributorsCollection[index + 1].id
            : null,
        previous: index > 0 ? contributorsCollection[index - 1].id : null,
      },
    }));
  });
};

const {
  contributorId,
  previous,
  next,
} = Astro.props as {
  contributorId: string;
  previous: string | null;
  next: string | null;
};

const memberEntry = await getEntry(
  "contributors",
  contributorId as CollectionEntry<"contributors">["id"],
);

if (!memberEntry) {
  throw new Error(`Missing contributor content entry for "${contributorId}".`);
}
---

<Layout title={`${memberEntry.data.name} | FujoCoded LLC`}>
  <article class="w-full rounded-xl bg-white drop-shadow-purple">
    <a href="/contributors">
      <h1>Our <em>contributors</em></h1>
    </a>
    <div>
      <ContributorCard {...memberEntry.data} slug={memberEntry.id} />
      <nav>
        <a
          class:list={{
            disabled: !previous,
          }}
          href={`/contributors/${previous}`}>Previous</a
        >
        <a href="/contributors/">All</a>
        <a
          class:list={{
            hidden: !next,
          }}
          href={`/contributors/${next}`}>Next</a
        >
      </nav>
    </div>
  </article>
</Layout>
<style>
  img {
    max-width: 150px;
    align-self: center;
  }
  ul {
    padding-left: 40px;
  }
  section {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  h2 {
    grid-column: span 2;
  }
  article {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  nav {
    margin-top: 30px;
    display: flex;
    gap: 15px;
    justify-content: space-evenly;
    width: 100%;
    max-width: 500px;
  }
  div {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .disabled {
    opacity: 25%;
    pointer-events: none;
  }
</style>
