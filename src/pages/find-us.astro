---
import FujoVerseCard from "../components/FujoVerseCard.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

const contacts = (await getCollection("contacts")).toSorted(
  (a, b) => a.data.order - b.data.order,
);

type FujoVerseLink = CollectionEntry<"contacts">["data"];

type FujoVerseColumn = {
  title: string;
  links: FujoVerseLink[];
};

const FUJOVERSE_COLUMNS: FujoVerseColumn[] = ["projects", "stores"].map(
  (group) => ({
    title: group === "projects" ? "Projects" : "Stores",
    links: contacts
      .filter((contact) => contact.data.group === group)
      .map(({ data }) => data),
  }),
);

const description =
  "Find FujoCoded projects, communities, and social spaces across the web.";
---

<Layout title="Find Us | FujoCoded LLC" description={description}>
  <article class="rounded-xl bg-white text-center drop-shadow-purple">
    <a href="#find-us">
      <h1 id="find-us">Find us across the <em>FujoVerse</em></h1>
    </a>
    <section
      class="fujoverse-section mt-10 border-t border-fujo-purple/15 pt-8 text-left sm:pt-10"
    >
      <div class="fujoverse-columns">
        {
          FUJOVERSE_COLUMNS.map((column) => {
            const headingId = `fujoverse-${column.title.toLowerCase()}`;
            return (
              <section
                class="fujoverse-column"
                aria-labelledby={`${headingId}-heading`}
              >
                <h3 id={`${headingId}-heading`} class="fujoverse-column-title">
                  {column.title}
                </h3>
                <ul class="fujoverse-grid">
                  {column.links.map((link, i) => (
                    <li class="m-0 min-w-0">
                      <FujoVerseCard
                        link={link}
                        tilt={i % 2 === 0 ? "-0.5deg" : "0.5deg"}
                      />
                    </li>
                  ))}
                </ul>
              </section>
            );
          })
        }
      </div>
    </section>
  </article>
</Layout>

<style>
  @property --gradient-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  .site-card {
    --gradient-pink-rgb: 255, 33, 233;
    --gradient-blue-rgb: 67, 96, 247;
    list-style: none;
    border: 2px solid transparent;
    background:
      linear-gradient(white, white) padding-box,
      conic-gradient(
          from var(--gradient-angle),
          rgba(var(--gradient-pink-rgb), 0.8),
          rgba(var(--gradient-blue-rgb), 0.8),
          rgba(var(--gradient-pink-rgb), 0.8),
          rgba(var(--gradient-blue-rgb), 0.8),
          rgba(var(--gradient-pink-rgb), 0.8)
        )
        border-box;
  }

  .site-card:has(:target) {
    border-width: 3px;
    background:
      linear-gradient(#fff8fd, #fff8fd) padding-box,
      conic-gradient(
          from var(--gradient-angle),
          rgb(var(--gradient-pink-rgb)),
          rgb(var(--gradient-blue-rgb)),
          rgb(var(--gradient-pink-rgb)),
          rgb(var(--gradient-blue-rgb)),
          rgb(var(--gradient-pink-rgb))
        )
        border-box;
  }

  .fujoverse-columns {
    display: grid;
    gap: 2rem;
    margin: 2rem 0 0;
  }

  .fujoverse-column {
    min-width: 0;
  }

  .fujoverse-column-title {
    margin: 0 0 0.75rem;
    color: #4d2e91;
    font-family: zeitung-mono, monospace;
    font-size: 1rem;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .fujoverse-grid {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .fujoverse-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .contact-row {
    transition: background 0.15s ease;
  }

  .contact-row:hover {
    background: linear-gradient(
      to right,
      rgba(var(--gradient-pink-rgb), 0.15),
      rgba(var(--gradient-blue-rgb), 0.1)
    );
  }

  .contact-row:active {
    background: linear-gradient(
      to right,
      rgba(var(--gradient-pink-rgb), 0.22),
      rgba(var(--gradient-blue-rgb), 0.16)
    );
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-card {
      animation: rotate-gradient 6s linear infinite;
      animation-delay: calc(var(--stagger) * -2s);
    }

    .site-card:has(:target) {
      animation-duration: 3s;
      transform: rotate(-1deg) scale(1.02);
    }

    @keyframes rotate-gradient {
      to {
        --gradient-angle: 360deg;
      }
    }
  }
</style>
