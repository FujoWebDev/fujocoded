---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import we_want_you from "../images/we_want_you.png";
import SubscriptionForm from "../components/SubscriptionForm.astro";

const description =
  "FujoCoded hires artists, writers, and web developers for small paid projects. Join our contributor roster and hear about new opportunities.";
---

<Layout title="Paid Opportunities | FujoCoded LLC" description={description}>
  <article class="rounded-xl bg-white drop-shadow-purple">
    <h1>Paid <em>opportunities</em></h1>

    <div class="flex flex-col gap-8 md:flex-row md:items-start">
      <div class="flex-1">
        <p class="text-pretty">
          <strong
            >FujoCoded regularly hires from our broader community for small paid
            projects</strong
          >—including art, character design, writing, web development, project
          management help, and whatever else the FujoVerse™ needs next. We hire
          folks <em>from all over the world</em>, and <strong
            >non-professionals are always welcome</strong
          >!
        </p>
        <p class="text-pretty">
          <strong
            >Throw your <a href="https://store.fujocoded.com/products/paddles"
              >yaoi paddle</a
            > in the ring👇
          </strong> And if the perfect opportunity isn't quite there right now, <a
            href="#business-card-drops">drop your application anyway!</a
          > We'll get in touch when a project that matches your skills comes along.
        </p>
      </div>

      <Image
        src={we_want_you}
        alt="A poster showing Boba-tan gleeful in front of fire and under a shower of money, in a very shiny suit jacket and sunglasses doing finger guns and saying 'FujoCoded needs your help!'"
        class="mx-auto w-64 shrink-0 rotate-2 md:-mr-16 md:ml-0"
      />
    </div>
    <a href="#hiring-right-now"><h2 id="hiring-right-now">Now Hiring:</h2></a>
    <p
      class="mx-auto my-4 max-w-2xl text-pretty rounded-lg bg-fujo-purple/5 px-4 py-3 text-sm leading-relaxed"
    >
      <strong>Forms not...<em>forming</em>?</strong>
      <a href="mailto:contacts@fujocoded.com">Write us an email</a>, <a
        href="/find-us#fujocoded">reach out on social</a
      >, or <a href="https://notavodkashot.carrd.co/"
        >DM our Project Manager Rie</a
      > for a quicker answer!
    </p>
    <ul class="with-discs">
      <li>
        <p class="text-pretty">
          <strong class="text-fujo-blue">📣 Voice of the Fujos:</strong> We're hiring
          a <strong>social media writer</strong> to
          <strike>save our founder</strike> help show our most sociable supporters
          that yes, indeed, <em>we do things</em>! A lot of them! If you can <strong
            >write in a fun, casual, and slightly chaotic style</strong
          >, and have <strong>2hr/week for the cause (and a fee)</strong>, fill
          out our
          <a href="https://forms.gle/MopyPns3ZoHgDuWd8"
            >Social Media Writer (ongoing) Application!</a
          >
        </p>
        <li>
          <p class="text-pretty">
            <strong class="text-fujo-blue">🧑‍🎨 Sexy(men) Connoisseur:</strong>
            Do you have a talent for designing sexy characters? Even better: do you
            have a talent for designing sexy<em class="text-fujo-pink"
              >...men</em
            > (of the <a href="https://en.wikipedia.org/wiki/Tumblr_Sexyman"
              >Tumblr variety</a
            >)? Your time has come: <strong
              >FujoCoded is hiring a character designer</strong
            > for our official <em>mascot</em>'s official <em>blorbo</em>'s
            official <em>fansona</em>! <a
              href="https://forms.gle/Cm2wq9numpBMoUZJA"
              >Drop your card in our form</a
            > and take up our challenge: <strong
              >NAND Cypher, from hit series <em>Binary Calls</em>—human edition!</strong
            >
          </p>
        </li>
      </li>
    </ul>

    <a href="#business-card-drops"
      ><h2 id="business-card-drops">Drop your business card!</h2></a
    >
    <p class="section-note">
      These forms help us find people for future (or current) paid work: once
      you fill one out, we'll keep your info on file and reach out to you when
      the right project comes along.
    </p>
    <ul class="with-discs">
      <li>
        <p class="text-pretty">
          <strong class="text-fujo-blue">✏️ Writers assemble!</strong> Want to help
          with our NPM articles? Or maybe you'd rather help us <a
            href="https://www.fujoweb.dev/characters"
            >sell the lore behind our catboys</a
          > (and beyond) to the wider public? <a
            href="https://forms.gle/DensB2JHppK4A98M8"
            >Join our writers roster</a
          >.
        </p>
      </li>
      <li>
        <p class="text-pretty">
          <strong class="text-fujo-blue">💻 WebDev gigs incoming!</strong> There
          is <em>a lot</em> going on in the FujoVerse™. Many pages (like the one
          on <a href="https://www.fujoweb.dev/volume-0">FujoGuide Volume 0</a>)
          could use some TLC from entry-level HTML/CSS wranglers, and we have
          bigger technical challenges waiting in the wings. <a
            href="https://forms.gle/HNMHCJ5N5XoV35Y27"
            >Join our web developer roster</a
          >
        </p>
      </li>
      <li>
        <p class="text-pretty">
          <strong class="text-fujo-blue">🖼️ Art(ist) archive!</strong> We’ve got
          character art needs simmering in the background (don’t we always?), and
          we’d love to know who to call when they become real projects—monsterfucking
          tendencies appreciated but not required. <a
            href="https://forms.gle/Cm2wq9numpBMoUZJA">Join our artist roster</a
          >
        </p>
      </li>
    </ul>

    <h2
      class="mb-8 text-center font-hatch text-[34px] font-medium italic text-fujo-pink"
    >
      Nothing here catches your eye?
    </h2>

    <p class="my-4 text-pretty text-center">
      Hear about future opportunities in <a href="/updates">our newsletter</a
      >—or subscribe below and let them come to you! ✨
    </p>
    <p class="my-4 text-pretty">
      <SubscriptionForm />
    </p>
  </article>
</Layout>

<style>
  @reference "../styles/global.css";

  ul.with-discs {
    list-style: disc;
    padding-left: 40px;
    display: flex;
    flex-direction: column;
    row-gap: 1rem;
    li:not(:first-child) {
      @apply mt-1;
    }

    & + * {
      @apply mt-6;
    }
  }
</style>
